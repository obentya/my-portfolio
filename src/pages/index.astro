---
const res = await fetch(
  `https://${import.meta.env.MICROCMS_SERVICE_DOMAIN}.microcms.io/api/v1/works?limit=100`,
  { headers: { 'X-MICROCMS-API-KEY': import.meta.env.MICROCMS_API_KEY } }
);
const { contents } = await res.json();
---

<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <meta name="robots" content="noindex, nofollow">
  <meta name="description" content="小川瑠美のポートフォリオ">
  <title>小川瑠美のポートフォリオ</title>
  <link rel="stylesheet" href="/css/bootstrap.css">
  <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
  <link href="/css/common23.css" rel="stylesheet">
  <link href="/css/style23.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0-11/css/all.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Shippori+Mincho&display=swap" rel="stylesheet">
</head>
<body>
  <section class="container">
    <header class="row d-flex justify-content-end p-2">
      <div class="col-2"><a href="#works">Works</a></div>
      <div class="col-2"><a href="#about">About</a></div>
    </header>
  </section>

  <section class="container-fluid mb-5">
    <figure class="row main_wrap">
      <img src="/img/ogawa_main.jpg" class="img-fluid">
      <figcaption class="main_text">こんにちは。<br>小川瑠美です。<br>よろしくお願いします。</figcaption>
    </figure>
  </section>

  <section class="container mb_05">
    <div class="row">
      <h2 class="col-12 g_font text-center fs300p mb-5" id="works">Works</h2>
      <div class="filter-controls col-10 offset-1 col-lg-4 offset-lg-4 mb-5">
        <div class="control">カテゴリ
          <select id="category-filter" class="filter-field form-control">
            <option value="">ALL</option>
            <option value="EC">EC案件</option>
            <option value="Web">Web案件</option>
            <option value="banner">banner</option>
            <option value="Paper">紙</option>
            <option value="Others">その他</option>
            <option value="App">App</option>
          </select>
        </div>
      </div>
      <div class="grid row px-3 mb_10">
        {contents.map((work) => (
          <div class="item col-6 col-lg-4 mb-4" data-category={(work.category ?? []).join(' ')}>
            <div class="item-content">
              <div class="custom-content">
                <img src={work.image.url} class="img-fluid border" alt={work.title}>
                {work.title}
              </div>
            </div>
          </div>
        ))}
      </div>
      <h2 class="col-12 g_font text-center fs300p mb-4" id="about">About</h2>
      <p class="col-10 offset-1 col-lg-8 offset-lg-2 text-center">
        初めまして。<br>
        小川瑠美と申します。<br>
        新卒から一環としてデザイン業務に関わった仕事をしております。<br>
        課題を解決に導く方法やプラン、仕組などを考えるのが好きです。<br>
        全ての仕事において一番に考る事はクライアントや、エンドユーザがどのように受け取るか、見やすか、わかりやすいか、使いやすいか、そして目標課題を解決できるかを考えてデザインをしています。
      </p>
    </div>
  </section>

  <section class="container-fluid">
    <footer class="row bg-dark">
      <div class="col-12 text-white text-center">（c）ogawa rumi</div>
    </footer>
  </section>

  <script is:inline src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
  <script is:inline>AOS.init();</script>
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/jquery/1.12.0/jquery.min.js"></script>
  <script is:inline src="/js/bootstrap.bundle.js"></script>
  <script is:inline>
    $(function () {
      $('#category-filter').on('change', function () {
        var target = $(this).val();
        $('.grid .item').each(function () {
          var cats = ($(this).attr('data-category') || '').split(' ');
          if (target === '' || cats.indexOf(target) !== -1) {
            $(this).fadeIn('slow');
          } else {
            $(this).fadeOut('slow');
          }
        });
      });
    });
  </script>
</body>
</html>