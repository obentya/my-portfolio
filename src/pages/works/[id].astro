---
export async function getStaticPaths() {
  const res = await fetch(
    `https://${import.meta.env.MICROCMS_SERVICE_DOMAIN}.microcms.io/api/v1/works?limit=100`,
    { headers: { 'X-MICROCMS-API-KEY': import.meta.env.MICROCMS_API_KEY } }
  );
  const { contents } = await res.json();
  return contents.map((work) => ({ params: { id: work.id }, props: { work } }));
}
const { work } = Astro.props;
---

<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <meta name="robots" content="noindex, nofollow">
  <title>{work.title} | 小川瑠美のポートフォリオ</title>
  <link rel="stylesheet" href="/css/bootstrap.css">
  <link href="/css/common23.css" rel="stylesheet">
  <link href="/css/style23.css" rel="stylesheet">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Shippori+Mincho&display=swap" rel="stylesheet">
</head>
<body>
  <section class="container">
    <header class="row d-flex justify-content-end p-2">
      <div class="col-2"><a href="/#works">Works</a></div>
      <div class="col-2"><a href="/#about">About</a></div>
    </header>
  </section>

  <section class="container mb_02 border-bottom mt-2 border-top pt-5">
    <div class="row">
      <div class="col-9 col-lg-8 offset-lg-1 mb-4">
        <img src={work.image.url} class="img-fluid border" alt={work.title}>
      </div>
      {work.image_sp && (
        <div class="col-3 col-lg-2 mb-4">
          <img src={work.image_sp.url} class="img-fluid border" alt={work.title}>
        </div>
      )}
    </div>
  </section>

  <section class="container mb_05 border-bottom">
    <div class="row mb-2">
      <div class="col-lg-10 offset-lg-1 mb-4">
        {work.client && <h4 class="col-12 fs100p"><b>{work.client}</b></h4>}
        {work.links && <div class="col-12 fs100p mb-3" set:html={work.links} />}
        {work.scope && (
          <p class="col-12 fs100p border-bottom pb-4" style="white-space: pre-line;">[内容]{"\n"}{work.scope}</p>
        )}
        {work.description && (
          <p class="col-12 fs100p" style="white-space: pre-line;">{work.description}</p>
        )}
      </div>
      <div class="col-6 offset-3 col-lg-4 offset-lg-4 border text-center mb-5">
        <a href="/" class="d-block py-3">TOPにもどる</a>
      </div>
    </div>
  </section>

  <section class="container-fluid">
    <footer class="row bg-dark">
      <div class="col-12 text-white text-center">（c）ogawa rumi</div>
    </footer>
  </section>
</body>
</html>